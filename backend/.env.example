# Copy to backend/.env and fill in. Never commit .env.
# Empty values are treated as "not set".

# --- App -------------------------------------------------------------------
APP_ENV=development                  # development | test | production
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173  # exact origin allowed by CORS

# --- Database (required) ----------------------------------------------------
# Local development: leave these out. `neon checkout <branch>` writes them to the project-root
# .env.local, which the backend reads automatically. Set them here only to override that.
# Production: set both as environment variables on the backend host.
# postgresql:// URLs are rewritten to postgresql+psycopg:// automatically.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require   # pooled: app traffic
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require  # direct: migrations

# --- Auth (required) --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Chat model -------------------------------------------------------------
# ollama            = local development
# openai_compatible = any hosted API with an OpenAI-style endpoint (production)
# There is no automatic fallback between providers.
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_CTX=4096

# Example: Google Gemini (free tier; key from https://aistudio.google.com/apikey).
# On the free tier Google may use prompts and document text to improve its products.
#   LLM_PROVIDER=openai_compatible
#   HOSTED_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   HOSTED_LLM_MODEL=gemini-3.8-flash
HOSTED_LLM_BASE_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=

# --- Embedding model --------------------------------------------------------
# Each embedding model gets its own Chroma collection. After switching, rebuild the vectors:
#   python -m scripts.reindex_documents
# Example: Google Gemini (the same API key as the chat model works)
#   EMBEDDING_PROVIDER=openai_compatible
#   EMBEDDING_MODEL=<an embedding model listed for your key, e.g. gemini-embedding-2>
#   HOSTED_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   MIN_RELEVANCE_SCORE=<recalibrate: similarity scores differ between embedding models>
EMBEDDING_PROVIDER=ollama            # ollama | openai_compatible
EMBEDDING_MODEL=nomic-embed-text
HOSTED_EMBEDDING_BASE_URL=
HOSTED_EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=                # e.g. 768 for Gemini (required with VECTOR_STORE=pgvector)

# --- Vector store -----------------------------------------------------------
# chroma: local folder (or Chroma Cloud). pgvector: a table in PostgreSQL (used in production).
VECTOR_STORE=chroma                  # chroma | pgvector
CHROMA_MODE=local                    # local (persistent directory) | cloud
CHROMA_PERSIST_DIR=data/chroma       # relative paths resolve against backend/
CHROMA_COLLECTION=documents
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# --- File storage -----------------------------------------------------------
STORAGE_BACKEND=local                # local | s3 (any S3-compatible store, e.g. Neon Object Storage)
LOCAL_UPLOAD_DIR=data/uploads
S3_BUCKET=                           # e.g. documents
# Neon Object Storage: `neon deploy` writes AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY and AWS_REGION to .env.local, and the backend reads those names too.
# Set the S3_* names only for other providers (they take priority when both are set).
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# --- RAG tuning -------------------------------------------------------------
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000                      # characters
CHUNK_OVERLAP=150                    # characters, must be < CHUNK_SIZE
RETRIEVAL_TOP_K=4
MIN_RELEVANCE_SCORE=0.55             # cosine similarity; chunks below it are never used as evidence
RELEVANCE_MARGIN=0.12                # also drop chunks scoring this far below the best chunk
HISTORY_WINDOW_MESSAGES=6

# --- Abuse control (requests per minute) -----------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=10        # per client IP, register + login
UPLOAD_RATE_LIMIT_PER_MINUTE=10      # per user
CHAT_RATE_LIMIT_PER_MINUTE=10        # per user
